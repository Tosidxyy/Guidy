{
  "name": "@guidy/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.local.jsonc --local --persist-to .wrangler/state/dev --ip 127.0.0.1 --port 8787",
    "dev:lan": "wrangler dev --config wrangler.local.jsonc --local --persist-to .wrangler/state/dev --ip 0.0.0.0 --port 8787",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "build": "wrangler deploy --dry-run --outdir dist",
    "format:check": "prettier --check src tests scripts eslint.config.js tsconfig.json wrangler*.jsonc package.json",
    "db:migrate": "node scripts/local-db.mjs migrate dev",
    "db:migrate:test": "node scripts/local-db.mjs migrate test",
    "db:list": "node scripts/local-db.mjs list dev",
    "schema:check": "node scripts/auth-schema.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "miniflare": "5.20261006.1-alpha",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "wrangler": "4.149.0"
  },
  "dependencies": {
    "better-auth": "1.7.7"
  }
}
