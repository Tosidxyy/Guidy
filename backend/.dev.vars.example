# Copy to .dev.vars for local configuration. Never commit the real file.
GUIDY_CORS_ORIGINS=["http://localhost:8082"]
# Set to the actual Windows LAN origin before native login; do not add /api/auth.
BETTER_AUTH_URL=http://YOUR_WINDOWS_LAN_IP:8787
# Generate at least 32 random bytes locally; leave this example blank.
BETTER_AUTH_SECRET=
