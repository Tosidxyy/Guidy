# Local configuration only; copy to .env if needed. Never commit the real .env.
GUIDY_ENVIRONMENT=local
# Optional for browser preview only. Native iPhone HTTP does not require CORS.
GUIDY_CORS_ORIGINS=["http://localhost:8082"]
# Database/Auth/provider credentials will be configured in subsequent M0 rounds.
# No server credential belongs in apps/mobile or EXPO_PUBLIC_* variables.
