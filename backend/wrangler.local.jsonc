{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "guidy-api-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-09",
  "workers_dev": false,
  "observability": { "enabled": false },
  "vars": { "GUIDY_CORS_ORIGINS": "[]" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "guidy-local-dev",
      "database_id": "local-guidy-dev",
      "migrations_dir": "migrations",
    },
  ],
}
