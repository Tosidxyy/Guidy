{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "guidy-api-local",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-09",
  "workers_dev": false,
  "observability": { "enabled": false },
  "workflows": [
    {
      "name": "guidy-research-local",
      "binding": "RESEARCH_WORKFLOW",
      "class_name": "ResearchWorkflow",
    },
  ],
  "vars": { "GUIDY_CORS_ORIGINS": "[]", "GUIDY_AUTH_MODE": "local-inbox" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "guidy-local-dev",
      "database_id": "local-guidy-dev",
      "migrations_dir": "migrations",
    },
  ],
}
