{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ],
      "npm:zod@3.25.76": [
        "./node_modules/zod"
      ],
      "npm:date-fns@4.4.0": [
        "./node_modules/date-fns"
      ],
      "npm:date-fns-tz@3.2.0": [
        "./node_modules/date-fns-tz"
      ]
    },
    "types": [
      "node",
      "vite/client"
    ]
  },
  "include": [
    "src",
    "components",
    "hooks",
    "lib",
    "shared",
    "store",
    "vite.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "functions",
    "dev"
  ]
}
