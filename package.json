{
  "name": "qoder-site-react-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "preinstall": "node scripts/check-node.mjs",
    "predev": "node scripts/sync-function-shared.mjs && node scripts/check-node.mjs",
    "prebuild": "node scripts/sync-function-shared.mjs && node scripts/check-node.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && node scripts/build.mjs && node scripts/build-function-package.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "dev:function": "npx deno run --config dev/deno.check.json --allow-net=127.0.0.1:8000 --allow-read --allow-env dev/function-local.ts",
    "dev:function:live": "node scripts/dev-function-node.mjs dev/function-live.ts",
    "check:function": "npx deno check --config dev/deno.check.json functions/app.ts",
    "sync:function": "node scripts/sync-function-shared.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "@tanstack/react-query": "^5.107.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-markdown": "^9.1.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "deno": "^2.9.6",
    "esbuild-wasm": "^0.28.2",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "8.0.16",
    "vitest": "^5.1.0"
  },
  "type": "module"
}
