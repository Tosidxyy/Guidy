# 本地真实模型联调（npm run dev:function:live）
# 方式一：复制为 .env.local 后填写；.env.local 已被 git 忽略，不会进仓库或浏览器。
# 方式二：LOCAL_LLM_CONFIG 指向一个 JSON 配置文件（字段 LOCAL_LLM_* 或 LIGHTMEM_*）。
LOCAL_LLM_BASE_URL=https://api.deepseek.com/v1
LOCAL_LLM_MODEL=deepseek-chat
LOCAL_LLM_API_KEY=
# 单轮输出上限，默认 3200；长计划被截断时可再调高（供应商允许范围内）
LLM_MAX_TOKENS=3200